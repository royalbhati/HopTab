# Build/release scripts are tracked (CI runs scripts/generate-pro-stub.sh), but
# the license minter stays local — it reads the Ed25519 signing key from the
# maintainer's Keychain and has no business in a public repo.
scripts/generate-license.sh

# Pro module (separate private repo).
# Still ignored on purpose — the open-source build gets a compile-only stub
# from scripts/generate-pro-stub.sh instead.
HopTabPro/

# License worker (separate deployment)
hoptab-license-worker/node_modules/
HopTab.app/

.wrangler/

# Internal strategy docs — never publish these to the open-source repo.
PRODUCT.md
DESIGN.md
LAUNCH_KIT.md

